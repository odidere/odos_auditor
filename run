#!/bin/bash
# run_tests.sh

# 1. Load Credentials
if [ -f .env ]; then
    export $(grep -v '^#' .env | xargs)
else
    echo "⚠️  No .env found. Ensure POSTGRES_PASSWORD is set manually."
fi

# 2. Python Version Check (Requirement for [T] syntax)
PYTHON_VER=$(python3 -c 'import sys; print(sys.version_info[:2] >= (3, 12))')
if [ "$PYTHON_VER" = "False" ]; then
    echo "❌ Error: Odos Service requires Python 3.12+ for Type Parameter syntax."
    exit 1
fi

# 3. Execution
echo "🚀 Running Odos Intelligence Suite..."
pytest tests/unit/ tests/integration/