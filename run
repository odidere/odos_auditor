#!/usr/bin/env bash
# Convenience wrapper. Usage: ./run [ui|api|audit|test|demo]
set -euo pipefail

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

case "${1:-help}" in
  ui)    odos ui ;;
  api)   odos api ;;
  audit) shift; odos audit "$@" ;;
  test)  pytest -q ;;
  demo)  odos init-db && odos audit --source mock && odos ui ;;
  *)     echo "Usage: ./run [ui|api|audit|test|demo]"; exit 1 ;;
esac
