# Copy to .env and fill in. Never commit .env.

# --- Odos database (omit everything to use a local SQLite file) ---
# DATABASE_URL=postgresql+psycopg2://odos:change-me@localhost:5432/odos_observability
POSTGRES_USER=odos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=odos_observability
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Cost source: snowflake | bigquery | mock ---
ODOS_COST_SOURCE=mock

# --- Snowflake (read-only role with access to SNOWFLAKE.ACCOUNT_USAGE; not ACCOUNTADMIN) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# Prefer key-pair auth:
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PASSWORD=

# --- BigQuery (uses Application Default Credentials) ---
GOOGLE_CLOUD_PROJECT=

# --- AI providers (optional; either or both) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# ODOS_OPENAI_MODEL=gpt-4.1-mini
# ODOS_GEMINI_MODEL=gemini-2.5-flash

# --- Access ---
ODOS_ADMIN_USER=admin
ODOS_ADMIN_PASSWORD=
ODOS_API_KEY=

LOG_LEVEL=INFO
