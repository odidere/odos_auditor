# ===============================================================

# Odos Auditor: Environment Configuration Template

# Copy this file to .env and fill in your actual credentials.

# ===============================================================

# --- DATABASE CONFIGURATION ---

# For local dev with SQLite, you can leave these blank if your code handles defaults.

# For Integration Tests/Production (PostgreSQL):

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=odos_observability
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SNOWFLAKE CONFIGURATION ---

# Required for actual data fetching (WarehouseAdvisor & Auditor)

SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_default_wh
SNOWFLAKE_DATABASE=your_audit_db
SNOWFLAKE_SCHEMA=your_audit_schema

# --- AI & LLM CONFIGURATION ---

# Required for the 'Surgeon' module (optimize_sql & diagnose_pipeline_failure)

OPENAI_API_KEY=sk-xxxx_your_openai_key
GEMINI_API_KEY=AIzaSy-xxxx_your_google_gemini_key

# --- SYSTEM SETTINGS ---

# Set to 'DEBUG' for verbose logging during development

LOG_LEVEL=INFO

# Set to 'true' if running inside a Docker container

IS_DOCKER=false
